// Generated by python -m gplay.powerbi_export from results/metrics.json.
// Run against the open GooglePlay model; every row must say PASS.
EVALUATE
VAR t = UNION (
ROW ( "check_id", 1, "measure", "[Apps]", "expected", 9659.0, "actual", [Apps], "tol", 0.000000000000 ),
ROW ( "check_id", 2, "measure", "[Games]", "expected", 1720.0, "actual", [Games], "tol", 0.000000000000 ),
ROW ( "check_id", 3, "measure", "[Games Filed Under Family]", "expected", 775.0, "actual", [Games Filed Under Family], "tol", 0.000000000000 ),
ROW ( "check_id", 4, "measure", "[Hit Rate]", "expected", 0.3517962522000207, "actual", [Hit Rate], "tol", 0.000001000000 ),
ROW ( "check_id", 5, "measure", "[Hit Rate Games]", "expected", 0.5296511627906977, "actual", [Hit Rate Games], "tol", 0.000001000000 ),
ROW ( "check_id", 6, "measure", "[Free Hit Rate]", "expected", 0.37911285794497473, "actual", [Free Hit Rate], "tol", 0.000001000000 ),
ROW ( "check_id", 7, "measure", "[Paid Hit Rate]", "expected", 0.029177718832891247, "actual", [Paid Hit Rate], "tol", 0.000001000000 ),
ROW ( "check_id", 8, "measure", "CALCULATE ( [Hit Rate], fact_apps[rating_band_order] = 1 )", "expected", 0.25206611570247933, "actual", CALCULATE ( [Hit Rate], fact_apps[rating_band_order] = 1 ), "tol", 0.000001000000 ),
ROW ( "check_id", 9, "measure", "CALCULATE ( [Hit Rate], fact_apps[rating_band_order] = 2 )", "expected", 0.46633416458852867, "actual", CALCULATE ( [Hit Rate], fact_apps[rating_band_order] = 2 ), "tol", 0.000001000000 ),
ROW ( "check_id", 10, "measure", "CALCULATE ( [Hit Rate], fact_apps[rating_band_order] = 3 )", "expected", 0.6039506172839506, "actual", CALCULATE ( [Hit Rate], fact_apps[rating_band_order] = 3 ), "tol", 0.000001000000 ),
ROW ( "check_id", 11, "measure", "CALCULATE ( [Hit Rate], fact_apps[rating_band_order] = 4 )", "expected", 0.6172363986519018, "actual", CALCULATE ( [Hit Rate], fact_apps[rating_band_order] = 4 ), "tol", 0.000001000000 ),
ROW ( "check_id", 12, "measure", "CALCULATE ( [Hit Rate], fact_apps[rating_band_order] = 5 )", "expected", 0.404296875, "actual", CALCULATE ( [Hit Rate], fact_apps[rating_band_order] = 5 ), "tol", 0.000001000000 ),
ROW ( "check_id", 13, "measure", "CALCULATE ( [Hit Rate], fact_apps[update_age_order] = 1 )", "expected", 0.5674386920980926, "actual", CALCULATE ( [Hit Rate], fact_apps[update_age_order] = 1 ), "tol", 0.000001000000 ),
ROW ( "check_id", 14, "measure", "CALCULATE ( [Hit Rate], fact_apps[update_age_order] = 2 )", "expected", 0.3294275192500837, "actual", CALCULATE ( [Hit Rate], fact_apps[update_age_order] = 2 ), "tol", 0.000001000000 ),
ROW ( "check_id", 15, "measure", "CALCULATE ( [Hit Rate], fact_apps[update_age_order] = 3 )", "expected", 0.2287878787878788, "actual", CALCULATE ( [Hit Rate], fact_apps[update_age_order] = 3 ), "tol", 0.000001000000 ),
ROW ( "check_id", 16, "measure", "CALCULATE ( [Hit Rate], fact_apps[update_age_order] = 4 )", "expected", 0.18460264900662252, "actual", CALCULATE ( [Hit Rate], fact_apps[update_age_order] = 4 ), "tol", 0.000001000000 ),
ROW ( "check_id", 17, "measure", "CALCULATE ( [Hit Rate], fact_apps[category] = 'EDUCATION' )", "expected", 0.5849, "actual", CALCULATE ( [Hit Rate], fact_apps[category] = "EDUCATION" ), "tol", 0.000100000000 ),
ROW ( "check_id", 18, "measure", "CALCULATE ( [Hit Rate], fact_apps[category] = 'GAME' )", "expected", 0.5704, "actual", CALCULATE ( [Hit Rate], fact_apps[category] = "GAME" ), "tol", 0.000100000000 ),
ROW ( "check_id", 19, "measure", "CALCULATE ( [Hit Rate], fact_apps[category] = 'BUSINESS' )", "expected", 0.1643, "actual", CALCULATE ( [Hit Rate], fact_apps[category] = "BUSINESS" ), "tol", 0.000100000000 ),
ROW ( "check_id", 20, "measure", "CALCULATE ( SUM ( fact_genre_scores[top_decile_share] ), fact_genre_scores[primary_genre] = 'Racing' )", "expected", 0.5869, "actual", CALCULATE ( SUM ( fact_genre_scores[top_decile_share] ), fact_genre_scores[primary_genre] = "Racing" ), "tol", 0.000100000000 ),
ROW ( "check_id", 21, "measure", "CALCULATE ( SUM ( fact_genre_scores[top_decile_share] ), fact_genre_scores[primary_genre] = 'Casual' )", "expected", 0.8404, "actual", CALCULATE ( SUM ( fact_genre_scores[top_decile_share] ), fact_genre_scores[primary_genre] = "Casual" ), "tol", 0.000100000000 ),
ROW ( "check_id", 22, "measure", "CALCULATE ( SUM ( fact_genre_scores[top_decile_share] ), fact_genre_scores[primary_genre] = 'Trivia' )", "expected", 0.972, "actual", CALCULATE ( SUM ( fact_genre_scores[top_decile_share] ), fact_genre_scores[primary_genre] = "Trivia" ), "tol", 0.000100000000 ),
ROW ( "check_id", 23, "measure", "CALCULATE ( [Negative Review Share], fact_category_sentiment[category] = 'GAME' )", "expected", 0.3515151515151515, "actual", CALCULATE ( [Negative Review Share], fact_category_sentiment[category] = "GAME" ), "tol", 0.000001000000 )
)
RETURN ADDCOLUMNS ( t, "result", IF ( ABS ( [actual] - [expected] ) <= [tol], "PASS", "FAIL" ) )
ORDER BY [check_id]
